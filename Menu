local loadedModules = {}

local function loadModule(moduleName)
    local moduleUrls = {
        General = "https://raw.githubusercontent.com/your_username/BloxFruit-Script/main/general.lua",
        PvP = "https://raw.githubusercontent.com/your_username/BloxFruit-Script/main/pvp.lua",
        Visuals = "https://raw.githubusercontent.com/your_username/BloxFruit-Script/main/visuals.lua",
        Info = "https://raw.githubusercontent.com/your_username/BloxFruit-Script/main/info.lua"
    }
    local url = moduleUrls[moduleName]
    if not url then return end

    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if not success then
        warn("Ошибка загрузки модуля " .. moduleName .. ": " .. tostring(err))
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Ошибка",
            Text = "Не удалось загрузить " .. moduleName,
            Duration = 5
        })
    end
end

local function switchTab(tabName)
    if isAnimating or currentTab == tabName then return end
    isAnimating = true

    local old = currentTab
    local oldPage = pages[old]
    local newPage = pages[tabName]

    -- Анимация сдвига страниц
    game:GetService("TweenService"):Create(oldPage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0, 0, -1, 0)}):Play()
    newPage.Position = UDim2.new(0, 0, 1, 0)
    game:GetService("TweenService"):Create(newPage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

    -- Обновляем стили кнопок
    local oldBtnData = buttons[old]
    local newBtnData = buttons[tabName]
    game:GetService("TweenService"):Create(oldBtnData.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
    game:GetService("TweenService"):Create(oldBtnData.text, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(180, 180, 180)}):Play()
    game:GetService("TweenService"):Create(oldBtnData.icon, TweenInfo.new(0.3), {ImageTransparency = 0.5}):Play()

    game:GetService("TweenService"):Create(newBtnData.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(45, 45, 45)}):Play()
    game:GetService("TweenService"):Create(newBtnData.text, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    game:GetService("TweenService"):Create(newBtnData.icon, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()

    currentTab = tabName

    -- Загружаем модуль вкладки, если ещё не загружен
    if not loadedModules[tabName] then
        loadModule(tabName)
        loadedModules[tabName] = true
    end

    task.wait(0.5)
    isAnimating = false
end

TabGeneral.MouseButton1Click:Connect(function() switchTab("General") end)
