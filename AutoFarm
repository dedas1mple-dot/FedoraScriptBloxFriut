-- AutoFarm.lua (исправлено: без глобальных кликов, с RemoteEvents)
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- ================== ФЛАГ РАБОТЫ ==================
local autoFarmActive = true
_G.StopAutoFarm = function()
    autoFarmActive = false
end

-- ================== НАСТРОЙКИ ==================
local QUESTS = {
    {
        minLevel = 0,
        questGiverName = "Bandit Quest Giver",
        questGiverCFrame = CFrame.new(1058.99231, 16.1369934, 1551.73328, 0.999752104, -0, -0.0222652908, 0, 1, -0, 0.0222652908, 0, 0.999752104),
        mobName = "Bandit",
        requiredKills = 5,
    },
    -- Добавьте следующие квесты, когда будут координаты
}

-- ================== ПЛАВНОЕ ПЕРЕМЕЩЕНИЕ ==================
local function smoothMoveTo(targetCFrame, speed)
    speed = speed or 200
    local currentCF = rootPart.CFrame
    local distance = (targetCFrame.Position - currentCF.Position).Magnitude
    if distance < 1 then return end

    local startTime = tick()
    while (tick() - startTime) < (distance / speed) and autoFarmActive do
        local alpha = (tick() - startTime) / (distance / speed)
        alpha = math.clamp(alpha, 0, 1)
        rootPart.CFrame = currentCF:Lerp(targetCFrame, alpha)
        task.wait()
    end
    rootPart.CFrame = targetCFrame
end

-- ================== ПОИСК МОДЕЛЕЙ ==================
local function findNearestModel(name, parent)
    parent = parent or workspace
    local nearest = nil
    local minDistance = math.huge
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == name then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hrp then
                local dist = (hrp.Position - rootPart.Position).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest, minDistance
end

-- ================== БЕЗОПАСНОЕ ВЗАИМОДЕЙСТВИЕ ==================
local function interactWithModel(model)
    if not model then return false end

    -- 1. Пробуем ClickDetector
    local clickDetector = model:FindFirstChildOfClass("ClickDetector")
    if clickDetector then
        fireclickdetector(clickDetector)
        return true
    end

    -- 2. Пробуем ProximityPrompt
    local prompt = model:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        fireproximityprompt(prompt)
        return true
    end

    -- 3. Отправляем RemoteEvent (нужно найти в игре)
    -- Ищем RemoteEvent в ReplicatedStorage, который отвечает за диалог/квест
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if remotes then
        local dialogEvent = remotes:FindFirstChild("Dialog") or remotes:FindFirstChild("Talk") or remotes:FindFirstChild("Quest")
        if dialogEvent then
            dialogEvent:FireServer(model)
            return true
        end
    end

    return false
end

-- ================== ВЫБОР КВЕСТА В GUI ==================
local function selectQuestInGui()
    local playerGui = player:WaitForChild("PlayerGui")
    local buttons = playerGui:GetDescendants()
    for _, obj in ipairs(buttons) do
        if obj:IsA("TextButton") then
            local text = string.lower(obj.Text)
            if text:find("accept") or text:find("ok") or text:find("да") or text:find("принять") then
                -- Нажимаем кнопку через событие
                obj.MouseButton1Click:Fire()
                task.wait(0.5)
                return true
            end
        end
    end
    return false
end

-- ================== ПОЛУЧЕНИЕ КВЕСТА ==================
local function takeQuest(quest)
    -- Перемещаемся к NPC
    if quest.questGiverCFrame then
        smoothMoveTo(quest.questGiverCFrame, 200)
        task.wait(1) -- ждём прогрузки
    else
        local questGiver = findNearestModel(quest.questGiverName)
        if questGiver then
            local hrp = questGiver:FindFirstChild("HumanoidRootPart") or questGiver:FindFirstChild("Head")
            if hrp then
                smoothMoveTo(CFrame.new(hrp.Position + Vector3.new(0, 3, 5)), 200)
                task.wait(0.5)
            end
        end
    end

    -- Находим NPC и взаимодействуем
    local questGiver = findNearestModel(quest.questGiverName)
    if questGiver and interactWithModel(questGiver) then
        task.wait(1)
        selectQuestInGui() -- пытаемся нажать Accept
        task.wait(1)
        return true
    end
    return false
end

-- ================== АТАКА МОБА ==================
local function attackMob(mob)
    if not mob or not character then return end
    local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
    if not mobHumanoid or mobHumanoid.Health <= 0 then return end

    local mobHRP = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
    if mobHRP then
        smoothMoveTo(CFrame.new(mobHRP.Position + Vector3.new(0, 0, -3)), 250)
        task.wait(0.3)
        -- Используем interactWithModel (если есть ClickDetector, сработает)
        -- Если нет, пробуем отправить RemoteEvent для атаки
        local success = interactWithModel(mob)
        if not success then
            -- Ищем RemoteEvent для атаки
            local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            if remotes then
                local attackEvent = remotes:FindFirstChild("Attack") or remotes:FindFirstChild("Damage") or remotes:FindFirstChild("Combat")
                if attackEvent then
                    attackEvent:FireServer(mob)
                end
            end
        end
        task.wait(0.5)
    end
end

-- ================== ПРОВЕРКА ЗДОРОВЬЯ ==================
local function checkHealth()
    if humanoid.Health <= 30 then
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        local currentQuest = QUESTS[1]
        for _, quest in ipairs(QUESTS) do
            if level >= quest.minLevel then
                currentQuest = quest
            end
        end
        -- Летим к квестодателю (безопасное место)
        if currentQuest.questGiverCFrame then
            smoothMoveTo(currentQuest.questGiverCFrame, 200)
        end
        task.wait(5)
    end
end

-- ================== ОСНОВНОЙ ЦИКЛ ==================
local function getCurrentQuest(level)
    local current = QUESTS[1]
    for _, quest in ipairs(QUESTS) do
        if level >= quest.minLevel then
            current = quest
        else
            break
        end
    end
    return current
end

local function autoFarmLoop()
    -- Экипируем кулаки (слот 1)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
    task.wait(0.5)

    while autoFarmActive and player.Character do
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        local currentQuest = getCurrentQuest(level)

        -- Берём квест
        if not takeQuest(currentQuest) then
            task.wait(5)
            continue
        end

        -- Убиваем мобов
        local killed = 0
        while killed < currentQuest.requiredKills and autoFarmActive do
            checkHealth()

            local mob = findNearestModel(currentQuest.mobName)
            if mob then
                attackMob(mob)
                local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
                if mobHumanoid and mobHumanoid.Health <= 0 then
                    killed = killed + 1
                    task.wait(0.5)
                end
            else
                task.wait(2)
            end
            task.wait(1)
        end

        -- Сдаём квест
        takeQuest(currentQuest)
        task.wait(2)

        print("Квест выполнен!")
    end
end

-- ================== ЗАПУСК ==================
if player.Character then
    autoFarmActive = true
    task.spawn(autoFarmLoop)
else
    player.CharacterAdded:Connect(function()
        character = player.Character
        humanoid = character:WaitForChild("Humanoid")
        rootPart = character:WaitForChild("HumanoidRootPart")
        autoFarmActive = true
        task.spawn(autoFarmLoop)
    end)
end
