-- AutoFarm.lua (исправлено: без фиксированных координат)
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

-- ================== ФЛАГ РАБОТЫ ==================
local autoFarmActive = true
_G.StopAutoFarm = function()
    autoFarmActive = false
end

-- ================== НАСТРОЙКИ ==================
local QUESTS = {
    {
        minLevel = 0,
        questGiverName = "Bandit Quest Giver",   -- проверьте точное имя в игре!
        mobName = "Bandit",
        requiredKills = 5,
    },
    {
        minLevel = 10,
        questGiverName = "Monkey Quest Giver",
        mobName = "Monkey",
        requiredKills = 6,
    },
    {
        minLevel = 20,
        questGiverName = "Gorilla Quest Giver",
        mobName = "Gorilla",
        requiredKills = 7,
    },
}

-- ================== ПЛАВНОЕ ПЕРЕМЕЩЕНИЕ ==================
local isMoving = false

local function smoothMoveTo(targetPos, speed)
    speed = speed or 200 -- скорость (можно подстроить)
    local currentPos = rootPart.Position
    local distance = (targetPos - currentPos).Magnitude
    if distance < 1 then return end

    isMoving = true
    local startTime = tick()
    local startCF = rootPart.CFrame
    local targetCF = CFrame.new(targetPos)

    while (tick() - startTime) < (distance / speed) and autoFarmActive do
        local alpha = (tick() - startTime) / (distance / speed)
        alpha = math.clamp(alpha, 0, 1)
        rootPart.CFrame = startCF:Lerp(targetCF, alpha)
        task.wait()
    end
    rootPart.CFrame = targetCF
    isMoving = false
end

-- ================== ПОИСК МОДЕЛЕЙ ==================
local function findNearestModel(name, parent)
    parent = parent or workspace
    local nearest = nil
    local minDistance = math.huge
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == name then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hrp then
                local dist = (hrp.Position - rootPart.Position).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest, minDistance
end

-- ================== ВЗАИМОДЕЙСТВИЕ (КЛИК) ==================
local function clickModel(model)
    if not model then return end
    local clickDetector = model:FindFirstChildOfClass("ClickDetector")
    if clickDetector then
        fireclickdetector(clickDetector)
    else
        local prompt = model:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            fireproximityprompt(prompt)
        else
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if hrp then
                local screenPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(hrp.Position)
                if onScreen then
                    mousemoveabs(screenPos.X, screenPos.Y)
                    task.wait(0.1)
                    mouse1click()
                end
            end
        end
    end
end

-- ================== ПОЛУЧЕНИЕ КВЕСТА ==================
local function takeQuest(questGiverName)
    local questGiver, dist = findNearestModel(questGiverName)
    if not questGiver then
        warn("Квестодатель не найден: " .. questGiverName)
        return false
    end

    -- Плавно подлетаем, если далеко
    if dist > 20 then
        local hrp = questGiver:FindFirstChild("HumanoidRootPart") or questGiver:FindFirstChild("Head")
        if hrp then
            smoothMoveTo(hrp.Position + Vector3.new(0, 3, 5), 200)
            task.wait(0.5)
        end
    end

    clickModel(questGiver)
    task.wait(1)
    return true
end

-- ================== АТАКА МОБА ==================
local function attackMob(mob)
    if not mob or not character then return end
    local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
    if not mobHumanoid or mobHumanoid.Health <= 0 then return end

    local mobHRP = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
    if mobHRP then
        -- Подлетаем вплотную
        smoothMoveTo(mobHRP.Position + Vector3.new(0, 0, -3), 250)
        task.wait(0.3)
        clickModel(mob)
        task.wait(0.5)
    end
end

-- ================== ПРОВЕРКА ЗДОРОВЬЯ ==================
local function checkHealth()
    if humanoid.Health <= 30 then
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        local currentQuest = QUESTS[1]
        for _, quest in ipairs(QUESTS) do
            if level >= quest.minLevel then
                currentQuest = quest
            end
        end
        -- Летим к квестодателю (безопасная зона)
        local questGiver, _ = findNearestModel(currentQuest.questGiverName)
        if questGiver then
            local hrp = questGiver:FindFirstChild("HumanoidRootPart") or questGiver:FindFirstChild("Head")
            if hrp then
                smoothMoveTo(hrp.Position + Vector3.new(0, 10, 0), 200)
            end
        end
        task.wait(5)
    end
end

-- ================== ОСНОВНОЙ ЦИКЛ ==================
local function getCurrentQuest(level)
    local current = QUESTS[1]
    for _, quest in ipairs(QUESTS) do
        if level >= quest.minLevel then
            current = quest
        else
            break
        end
    end
    return current
end

local function autoFarmLoop()
    while autoFarmActive and player.Character do
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        local currentQuest = getCurrentQuest(level)

        -- Берем квест
        if not takeQuest(currentQuest.questGiverName) then
            task.wait(5)
            continue
        end

        -- Убиваем мобов
        local killed = 0
        while killed < currentQuest.requiredKills and autoFarmActive do
            checkHealth()

            local mob, dist = findNearestModel(currentQuest.mobName)
            if mob then
                attackMob(mob)
                local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
                if mobHumanoid and mobHumanoid.Health <= 0 then
                    killed = killed + 1
                    task.wait(0.5)
                end
            else
                task.wait(2) -- ждём респавна
            end
            task.wait(1)
        end

        -- Сдаем квест
        takeQuest(currentQuest.questGiverName)
        task.wait(2)

        print("Квест выполнен!")
    end
end

-- ================== ЗАПУСК ==================
if player.Character then
    autoFarmActive = true
    task.spawn(autoFarmLoop)
else
    player.CharacterAdded:Connect(function()
        character = player.Character
        humanoid = character:WaitForChild("Humanoid")
        rootPart = character:WaitForChild("HumanoidRootPart")
        autoFarmActive = true
        task.spawn(autoFarmLoop)
    end)
end
