-- AutoFarm.lua
-- Автофарм для Blox Fruit (Bandit, Monkey, Gorilla)

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

-- ================== ФЛАГ РАБОТЫ ==================
local autoFarmActive = true
_G.StopAutoFarm = function()
    autoFarmActive = false
end

-- ================== НАСТРОЙКИ ==================
local QUESTS = {
    {
        minLevel = 0,
        islandName = "Starter Island",
        questGiverName = "Bandit Quest Giver",  -- возможно "Bandit Quest Giver 1"
        mobName = "Bandit",
        requiredKills = 5,
        islandPosition = Vector3.new(100, 10, 100),  -- координаты безопасной точки на острове
    },
    {
        minLevel = 10,
        islandName = "Jungle",
        questGiverName = "Monkey Quest Giver",
        mobName = "Monkey",
        requiredKills = 6,
        islandPosition = Vector3.new(200, 20, 300),
    },
    {
        minLevel = 20,
        islandName = "Jungle",
        questGiverName = "Gorilla Quest Giver",
        mobName = "Gorilla",
        requiredKills = 7,
        islandPosition = Vector3.new(250, 25, 350),
    },
    -- Добавьте следующие уровни позже
}

-- ================== ФУНКЦИИ ПОИСКА ==================
local function findNearestModel(name, parent)
    parent = parent or workspace
    local nearest = nil
    local minDistance = math.huge
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == name then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hrp then
                local dist = (hrp.Position - rootPart.Position).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest, minDistance
end

-- ================== ТЕЛЕПОРТ ==================
local function teleportTo(position)
    if rootPart and rootPart.Parent then
        rootPart.CFrame = CFrame.new(position)
    end
end

-- ================== ВЗАИМОДЕЙСТВИЕ (КЛИК) ==================
local function clickModel(model)
    if not model then return end
    local clickDetector = model:FindFirstChildOfClass("ClickDetector")
    if clickDetector then
        fireclickdetector(clickDetector)
    else
        -- Если нет ClickDetector, пробуем ProximityPrompt
        local prompt = model:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
            fireproximityprompt(prompt)
        else
            -- Симуляция клика мышью по позиции модели
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
            if hrp then
                -- Перемещаем мышь на объект и кликаем
                local screenPos, onScreen = workspace.CurrentCamera:WorldToScreenPoint(hrp.Position)
                if onScreen then
                    mousemoveabs(screenPos.X, screenPos.Y)
                    task.wait(0.1)
                    mouse1click()
                end
            end
        end
    end
end

-- ================== ПОЛУЧЕНИЕ КВЕСТА ==================
local function takeQuest(questGiverName)
    local questGiver, dist = findNearestModel(questGiverName)
    if not questGiver then
        warn("Квестодатель не найден: " .. questGiverName)
        return false
    end

    -- Подходим к NPC (если далеко)
    if dist > 50 then
        local hrp = questGiver:FindFirstChild("HumanoidRootPart") or questGiver:FindFirstChild("Head")
        if hrp then
            teleportTo(hrp.Position + Vector3.new(0, 3, 5))
            task.wait(1)
        end
    end

    -- Кликаем по NPC (берем или сдаем квест)
    clickModel(questGiver)
    task.wait(1)
    return true
end

-- ================== АТАКА МОБА ==================
local function attackMob(mob)
    if not mob or not character then return end
    local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
    if not mobHumanoid or mobHumanoid.Health <= 0 then return end

    -- Телепортируемся рядом с мобом
    local mobHRP = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Head")
    if mobHRP then
        teleportTo(mobHRP.Position + Vector3.new(0, 0, -5))
        task.wait(0.5)
        -- Клик по мобу (атака)
        clickModel(mob)
        task.wait(0.8)
    end
end

-- ================== ПРОВЕРКА ЗДОРОВЬЯ ==================
local function checkHealth()
    if humanoid.Health <= 30 then
        -- Находим безопасную точку (используем текущий остров)
        local currentQuest = QUESTS[1] -- fallback
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        for _, quest in ipairs(QUESTS) do
            if level >= quest.minLevel then
                currentQuest = quest
            end
        end
        teleportTo(currentQuest.islandPosition)
        task.wait(5) -- ждём восстановления здоровья
    end
end

-- ================== ОСНОВНОЙ ЦИКЛ ==================
local function getCurrentQuest(level)
    local current = QUESTS[1]
    for _, quest in ipairs(QUESTS) do
        if level >= quest.minLevel then
            current = quest
        else
            break
        end
    end
    return current
end

local function autoFarmLoop()
    while autoFarmActive and player.Character do
        local level = player.Data and player.Data.Level and player.Data.Level.Value or 1
        local currentQuest = getCurrentQuest(level)

        -- Телепортируемся на остров, если далеко
        if (rootPart.Position - currentQuest.islandPosition).Magnitude > 200 then
            teleportTo(currentQuest.islandPosition)
            task.wait(2)
        end

        -- Получаем квест
        if not takeQuest(currentQuest.questGiverName) then
            task.wait(2)
            continue
        end

        -- Убиваем необходимое количество мобов
        local killed = 0
        while killed < currentQuest.requiredKills and autoFarmActive do
            checkHealth()

            local mob, dist = findNearestModel(currentQuest.mobName)
            if mob then
                attackMob(mob)
                -- Проверяем, умер ли моб
                local mobHumanoid = mob:FindFirstChildOfClass("Humanoid")
                if mobHumanoid and mobHumanoid.Health <= 0 then
                    killed = killed + 1
                    task.wait(0.5)
                end
            else
                -- Мобов нет, ждём респавна
                task.wait(2)
            end
            task.wait(1)
        end

        -- Сдаём квест
        takeQuest(currentQuest.questGiverName)
        task.wait(2)

        print("Квест выполнен!")
    end
end

-- ================== ЗАПУСК ==================
if player.Character then
    autoFarmActive = true
    task.spawn(autoFarmLoop)
else
    player.CharacterAdded:Connect(function()
        character = player.Character
        humanoid = character:WaitForChild("Humanoid")
        rootPart = character:WaitForChild("HumanoidRootPart")
        autoFarmActive = true
        task.spawn(autoFarmLoop)
    end)
end
