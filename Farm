-- farm.lua
local FarmContainer = _G.FarmContainer

local AutoFarmSection = _G.CreateSection(FarmContainer, "Auto Farming", 120)

-- Тумблер Auto Farm (переименовано из Auto Click)
local autoFarmToggle, getAutoFarmState = _G.CreateToggle(AutoFarmSection, "Auto Farm", false)
autoFarmToggle.MouseButton1Click:Connect(function()
    task.wait(0.1)
    if getAutoFarmState() then
        -- Загружаем внешний скрипт AutoFarm
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/dedas1mple-dot/FedoraScriptBloxFriut/refs/heads/main/AutoFarm"))()
        end)
        if not success then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Auto Farm",
                Text = "Ошибка загрузки: " .. tostring(err),
                Duration = 5
            })
        end
    else
        -- Отключаем автофарм, если он запущен (функция должна быть глобальной)
        if _G.StopAutoFarm then
            _G.StopAutoFarm()
        end
    end
end)

-- Дополнительная секция для будущих функций
local MiscSection = _G.CreateSection(FarmContainer, "Misc", 100)
_G.CreateLabel(MiscSection, "Здесь можно добавить другие функции фарма.")
